---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile, publications, education, experience } from '../data/profile';
---
<Layout title="Curriculum vitae — Mengqi Li" description="Education, research, publications, and experience of Mengqi Li, Computer Science PhD student at CUHK-Shenzhen.">
  <main class="cv-page wrap" id="main">
    <div id="top"></div>
    <div class="cv-toolbar"><a class="text-link" href="/">← Back to home</a><button class="button js-only" id="print-cv">Print / Save PDF <Icon name="down" size={15} /></button></div>
    <div class="cv-heading"><p class="eyebrow">CURRICULUM VITAE</p><h1>Mengqi Li <span lang="zh">李梦琦</span></h1><p>PhD student in Computer Science · School of Data Science</p><p>{profile.institution}</p><div class="cv-contact"><a href={`mailto:${profile.email}`}>{profile.email}</a><a href={profile.github}>github.com/ElementQi</a></div></div>
    <section><h2>Research interests</h2><p>Large language model reasoning and self-training; mathematical optimization for machine learning; efficient algorithms for large-scale training.</p></section>
    <section><h2>Education</h2>{education.map(item => <div class="cv-entry"><span>{item.period}</span><div><h3>{item.degree}</h3><p>{item.school}</p>{item.note && <p>{item.note}</p>}</div></div>)}</section>
    <section><h2>Selected publications</h2>{publications.map(paper => <article class="cv-publication"><h3><a href={paper.paper}>{paper.title}</a></h3><p>{paper.authors.map((author, i) => <>{i > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p><p>{paper.venue}{paper.id === 'sept' && ` · revised ${paper.year}`} · <a href={paper.paper}>Paper</a> · <a href={paper.code}>Code</a></p></article>)}</section>
    <section><h2>Research & professional experience</h2>{experience.map(item => <div class="cv-entry"><span>{item.period}</span><div><h3>{item.role}</h3><p>{item.organization}</p><p class="muted">{item.description}</p></div></div>)}</section>
    <section><h2>Honors & awards</h2><ul class="cv-awards"><li>Academic Scholarships (2nd & 3rd Class), Lanzhou University <span>2019–2023</span></li><li>S Prize, Interdisciplinary Contest in Modeling <span>2021 & 2022</span></li><li>Second Prize (Big Data) & Third Prize (AI), National College Computer Power Challenge <span>2021</span></li><li>Third Prize, National Green Computing Contest Series <span>2020</span></li></ul></section>
    <section><h2>Technical skills</h2><p>Python, Java, SQL, Shell · PyTorch, Hugging Face Transformers, VERL · Linux, Git, Docker</p></section>
  </main>
  <script>document.querySelector('#print-cv')?.addEventListener('click', () => window.print());</script>
</Layout>
