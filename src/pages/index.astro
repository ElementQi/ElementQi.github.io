---
import Layout from '../layouts/Layout.astro';
import { profile, publications } from '../data/profile';
const summaries = {
  sept: 'A study of reward-free self-training for language model reasoning using self-generated responses.',
  streambp: 'Memory-efficient backpropagation for long-sequence training, preserving the exact mathematical gradient.',
};
---
<Layout>
  <main id="main" class="home-page">
    <div id="top"></div>
    <section class="intro wrap" aria-labelledby="hero-title">
      <h1 id="hero-title">Mengqi Li <span lang="zh">李梦琦</span></h1>
      <p class="affiliation"><strong>PhD student in Computer Science</strong><br />School of Data Science, The Chinese University of Hong Kong, Shenzhen</p>
      <p>I work across machine learning research and software development, with a particular interest in mathematical optimization. I am advised by <a href={profile.advisor.url}>Prof. Xiao Li</a>.</p>
      <p>Previously, I received my M.S. in Data Science from CUHK-Shenzhen and my B.S. in Computer Science from Lanzhou University.</p>
      <div class="intro-links"><a href={`mailto:${profile.email}`}>Email</a><a href={profile.github}>GitHub</a><a href="/cv/">CV</a></div>
    </section>

    <section class="featured-section wrap" id="work" aria-labelledby="work-title">
      <h2 id="work-title">Selected publications</h2>
      {publications.map(paper => <article class="featured-entry" aria-labelledby={`${paper.id}-title`}>
        <div class="publication-meta"><strong>{paper.name}</strong><span>{paper.venue}{paper.id === 'sept' ? ` · ${paper.year}` : ''}</span></div>
        <div class="publication-body">
        <h3 id={`${paper.id}-title`}><a href={paper.paper}>{paper.title}</a></h3>
        <p class="authors">{paper.authors.map((author, i) => <>{i > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p>
        <p class="publication-summary">{summaries[paper.id as keyof typeof summaries]}</p>
        <div class="featured-links"><a href={paper.paper}>Paper</a><a href={paper.code}>Code</a><a href={`/research/#${paper.id}-title`}>Method details</a></div>
        </div>
      </article>)}
      <a class="text-link" href="/research/">Papers & research details</a>
    </section>

    <section class="personal-section wrap" id="about" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <div class="personal-copy"><p>Beyond my current work, chemistry, physics, biology, robotics, and FPGAs are subjects I would like to explore. I have also worked on small Raspberry Pi 3B projects.</p></div>
    </section>

    <section class="contact-section wrap" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <div class="contact-row"><a href={`mailto:${profile.email}`}>{profile.email}</a><button class="text-link js-only" data-copy={profile.email} data-message="Email address copied">Copy email</button></div>
    </section>
  </main>
</Layout>
