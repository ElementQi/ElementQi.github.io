---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PaperArt from '../components/PaperArt.astro';
import { profile, publications } from '../data/profile';
---
<Layout title="Research ? Mengqi Li">
  <main id="main">
    <div id="top"></div>
    <div class="research-intro wrap"><a class="text-link" href="/">? Back to home</a><p class="eyebrow">RESEARCH</p><h1>A closer look<br />at <em>the work.</em></h1><p>Selected papers, the ideas behind them, and the code to explore further.</p></div>

    <section class="research-section wrap section" id="research" aria-labelledby="research-title">
      <div class="section-heading"><div><p class="eyebrow section-index">01 / SELECTED WORK</p><h2 id="research-title">Selected <em>papers.</em></h2></div><span class="section-aside">Papers & open-source code</span></div>
      <div class="papers">
        {publications.map((paper, index) => <article class="paper" aria-labelledby={`${paper.id}-title`}>
          <PaperArt kind={paper.id} />
          <div class="paper-content">
            <div class="paper-meta"><span class:list={['venue', { 'venue-accent': paper.id === 'streambp' }]}>{paper.venue}{paper.id === 'sept' ? ` · ${paper.year}` : ''}</span><span>{paper.topic}</span><span class="paper-number">0{index + 1}</span></div>
            <h3 id={`${paper.id}-title`}><a href={paper.paper}>{paper.title}</a></h3>
            <p class="authors">{paper.authors.map((author, i) => <>{i > 0 && ', '}{author === profile.name ? <strong>{author}</strong> : author}</>)}</p>
            <p class="paper-description">{paper.description}</p>
            <div class="paper-links"><a href={paper.paper}>Paper <Icon size={13} /></a><a href={paper.code}>Code <Icon size={13} /></a><button class="js-only" data-copy={paper.bibtex} data-message={`${paper.name} citation copied`} data-fallback={`#citation-${paper.id}`}>Cite <Icon name="copy" size={13} /></button><details class="paper-summary"><summary>Overview <span aria-hidden="true">+</span></summary><p>{paper.summary}</p><details class="citation" id={`citation-${paper.id}`}><summary>BibTeX</summary><pre>{paper.bibtex}</pre></details></details></div>
          </div>
        </article>)}
      </div>
      <a class="research-github text-link" href={profile.github}>More on GitHub <Icon size={15} /></a>
    </section>

  </main>
</Layout>
